# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter API Key (from openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model (free models available)
# Free options: meta-llama/llama-3.2-3b-instruct:free, google/gemma-2-9b-it:free
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Ollama Configuration (local fallback)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# Bot Settings
ALLOWED_USER_IDS=  # Comma-separated Telegram user IDs (leave empty to allow all)
MAX_HISTORY_LENGTH=10
